<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.1.2.4</Version>
    <PackageProjectUrl>https://github.com/ElyFura/GlamourDocumenter</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>false</IsPackable>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

    <ItemGroup>
      <Content Include="..\icons\icon.png" Link="icons\icon.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Visible>false</Visible>
      </Content>
    </ItemGroup>
  <!--
    Externe IPC-Bindings für Dritt-Plugins. Penumbra.Api und Glamourer.Api
    sind nicht Teil der Dalamud-SDK und müssen weiter explizit
    referenziert werden. Customize+ verwendet rein string-basierte
    IPC-Endpoints und braucht kein Paket.
  -->
  <ItemGroup>
    <PackageReference Include="Penumbra.Api" Version="5.13.1" />
    <PackageReference Include="Glamourer.Api" Version="2.8.0" />
  </ItemGroup>

</Project>
