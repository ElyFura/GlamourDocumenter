<Project Sdk="Dalamud.NET.Sdk/14.0.2">

  <!--
    ====================================================================
    GlamourDocumenter.csproj

    Dalamud-Plugin für FFXIV. Nutzt die offizielle Dalamud.NET.Sdk —
    diese liefert TargetFramework, alle Standard-Refs (Dalamud,
    Dalamud.Bindings.ImGui, FFXIVClientStructs, Lumina, Lumina.Excel,
    Newtonsoft.Json) und den DalamudPackager-MSBuild-Task. Damit
    entfallen die früher hartkodierten <Reference HintPath>-Pfade auf
    %AppData%\XIVLauncher\addon\Hooks\dev — der Build ist jetzt auf
    jeder Maschine reproduzierbar.

    Siehe: https://dalamud.dev/plugin-development/how-tos/v12-SDK-migration
    Sample: https://github.com/goatcorp/SamplePlugin
    ====================================================================
  -->

  <PropertyGroup>
    <Version>0.1.1.0</Version>
    <PackageProjectUrl>https://github.com/ElyFura/GlamourDocumenter</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>false</IsPackable>

    <!--
      Code-Stil-Defaults; alles andere (TargetFramework, Platform,
      Nullable usw.) zieht die SDK selbst.
    -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Externe IPC-Bindings für Dritt-Plugins. Penumbra.Api und Glamourer.Api
    sind nicht Teil der Dalamud-SDK und müssen weiter explizit
    referenziert werden. Customize+ verwendet rein string-basierte
    IPC-Endpoints und braucht kein Paket.
  -->
  <ItemGroup>
    <PackageReference Include="Penumbra.Api" Version="5.13.1" />
    <PackageReference Include="Glamourer.Api" Version="2.8.0" />
  </ItemGroup>

</Project>
